#!/usr/bin/env bash
# 빠른 로컬 게이트. 전체 검증(npm run verify)과 CI를 대체하지 않는다.
# 통과 시 출력 최소화, 실패 시 마지막 40줄만 보여준다(AI 컨텍스트 절약).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"

# 보호 브랜치에서 직접 커밋 금지(docs/standards/BRANCHING.md). 작업 브랜치를 만든다.
case "$(git branch --show-current)" in
  dev | stg | prod | main) echo "보호 브랜치에서 직접 커밋 금지 → git switch -c feature/<이름>" >&2; exit 1 ;;
esac

if ! out="$(python3 scripts/check-history.py 2>&1)"; then
  echo "$out" >&2
  echo "→ docs/HISTORY.md 맨 위에 이 커밋 항목을 추가하고 스테이징 (docs/standards/HISTORY.md)" >&2
  exit 1
fi

staged=()
while IFS= read -r -d '' f; do staged+=("$f"); done < <(git diff --cached --name-only -z --diff-filter=ACMR)
[ ${#staged[@]} -gt 0 ] || exit 0

if ! out="$(node_modules/.bin/prettier --check --ignore-unknown --log-level warn "${staged[@]}" 2>&1)"; then
  echo "$out" | tail -n 40
  echo "→ npm run format" >&2
  exit 1
fi

# 앱 소스와 관련된 테스트만. 한글 경로 대응으로 앱 기준 상대경로를 넘긴다.
for app in web api; do
  files=()
  for f in "${staged[@]}"; do
    case "$f" in apps/"$app"/src/*.ts | apps/"$app"/src/*.tsx) files+=("${f#apps/"$app"/}") ;; esac
  done
  [ ${#files[@]} -gt 0 ] || continue
  if ! out="$(cd "apps/$app" && npm run --silent test:related -- "${files[@]}" 2>&1)"; then
    echo "$out" | tail -n 40
    exit 1
  fi
done
