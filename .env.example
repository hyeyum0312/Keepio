# 복사해서 .env로 사용한다: cp .env.example .env
# 값은 docker-compose.yml의 로컬 전용 계정이다. 실제 비밀값을 이 파일에 넣지 않는다.
# development | test | production (production이면 JSON 로그)
NODE_ENV=development
DATABASE_URL=postgresql://keepio:keepio_local@localhost:7712/keepio
DATABASE_URL_TEST=postgresql://keepio:keepio_local@localhost:7712/keepio_test
DB_POOL_MAX=10
PORT=7711
WEB_ORIGIN=http://localhost:7710
# 모든 환경 필수(32바이트 이상). 로컬 값 생성: openssl rand -base64 48
JWT_SECRET=
# 운영에서만 필수. 개발은 메일을 보내지 않고 인증·재설정 링크를 콘솔에 출력한다
RESEND_API_KEY=
MAIL_FROM=
# api 앞단 프록시 수. 프록시 뒤에서만 1 이상으로 둔다(잘못 두면 IP 위조 가능)
TRUST_PROXY_HOPS=0
