// 스키마 원본. 테이블 설계는 docs/spec/04-DATABASE-API.md.
// 접속 정보는 prisma.config.ts(DATABASE_URL)에 있다.

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // 활성 북마크 중복 방지용 부분 UNIQUE 인덱스를 스키마에 둔다(SQL로만 두면 이후 마이그레이션이 지우려 한다)
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// 플랜 등은 해당 기능에서 추가한다
model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 정규화(trim·소문자)된 값. 이메일을 주지 않는 소셜 계정이 있어 NULL 허용(FEAT-003)
  email              String?
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  bookmarks          Bookmark[]
  passwordCredential PasswordCredential?
  refreshTokens      RefreshToken[]
  emailTokens        EmailToken[]
  oauthAccounts      OAuthAccount[]
  tags               Tag[]
  categories         Category[]

  // 동시 가입의 최종 권위(FEAT-003 AC-04)
  @@unique([email], map: "users_email_key", where: raw("email IS NOT NULL"))
  @@map("users")
}

// 소셜·패스키 전용 계정은 비밀번호가 없으므로 users와 분리한다
model PasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

// 원문은 쿠키에만 있고 DB에는 SHA-256만 둔다. family = 한 번의 로그인에서 회전으로 이어진 토큰 묶음
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash Bytes     @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.ByteA
  // 첫 로그인 기준 절대 만료. 회전해도 같은 값을 물려받는다(FEAT-003 Q-3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  // 만료 행 정리(FEAT-003 Q-7)
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum EmailTokenPurpose {
  verify_email
  reset_password

  @@map("email_token_purpose")
}

model EmailToken {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash Bytes             @unique(map: "email_tokens_token_hash_key") @map("token_hash") @db.ByteA
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_tokens")
}

model Bookmark {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  originalUrl        String           @map("original_url")
  normalizedUrl      String           @map("normalized_url")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  // raw INSERT도 값을 갖도록 DB 기본값을 함께 둔다
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)
  // FEAT-010. 사용자가 저장할 때 넣은 제목(선택)과 링크 페이지의 og:title(자동, 표시 제목 대체용)
  title              String?          @db.VarChar(100)
  pageTitle          String?          @map("page_title") @db.VarChar(300)
  // 썸네일 파일 키(서버가 만든 무작위 이름). 기존 행은 썸네일 없음(failed)
  thumbnailKey       String?          @map("thumbnail_key")
  thumbnailStatus    ThumbnailStatus  @default(failed) @map("thumbnail_status")
  thumbnailSource    ThumbnailSource? @map("thumbnail_source")
  // 링크 페이지의 og:image 원본 주소(자동 수집). 보관 파일을 못 쓰면 화면이 이 주소로 바로 불러온다
  thumbnailSourceUrl String?          @map("thumbnail_source_url") @db.VarChar(2048)
  // 링크 페이지가 알려 준 사이트 아이콘 주소(FEAT-010 AC-15). 썸네일이 없을 때 아트워크 위에 올린다
  faviconUrl         String?          @map("favicon_url") @db.VarChar(2048)
  // 리다이렉트를 따라간 마지막 주소(FEAT-010 AC-19, 짧은 주소 등). 표시 제목의 사이트 이름에만 쓴다
  resolvedUrl        String?          @map("resolved_url") @db.VarChar(2048)
  // FEAT-008. 링크당 0~1개(ADR-015). NULL = 미분류. 카테고리를 지우면 링크는 남고 미분류가 된다
  categoryId         String?          @map("category_id") @db.Uuid
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  category           Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags               BookmarkTag[]

  // 활성 북마크는 사용자별 정규화 URL당 하나. 동시 저장의 최종 권위(FEAT-001 AC-03)
  @@unique([userId, normalizedUrl], map: "bookmarks_active_user_url_key", where: raw("deleted_at IS NULL"))
  // 삭제된 행 포함 조회(AC-07 복구 안내)와 사용자별 목록
  @@index([userId, normalizedUrl])
  // 활성 목록(최근 저장 순, 키셋 페이지, FEAT-002 AC-01·02). 휴지통 인덱스는 빈도 측정 후
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "bookmarks_active_list_idx", where: raw("deleted_at IS NULL"))
  // 카테고리별 활성 목록(FEAT-008 AC-11 필터). 링크 수 집계도 이 인덱스를 쓴다
  @@index([userId, categoryId, createdAt(sort: Desc), id(sort: Desc)], map: "bookmarks_active_category_idx", where: raw("deleted_at IS NULL"))
  @@map("bookmarks")
}

enum OAuthProvider {
  google
  kakao

  @@map("oauth_provider")
}

// 소셜 계정 연결(FEAT-004). 제공자의 이메일·이름·사진·토큰은 저장하지 않는다(로그인에 불필요)
model OAuthAccount {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  provider  OAuthProvider
  // 제공자 안에서 사용자를 영구히 가리키는 ID(ID 토큰 sub). 이메일은 바뀔 수 있어 키로 쓰지 않는다
  subject   String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 동시 콜백의 최종 권위(FEAT-004 AC-10)
  @@unique([provider, subject], map: "oauth_accounts_provider_subject_key")
  @@index([userId])
  @@map("oauth_accounts")
}

// FEAT-010 썸네일. 저장 직후 pending → 자동 수집 결과 ready/failed. 직접 올리면 ready·upload
enum ThumbnailStatus {
  pending
  ready
  failed

  @@map("thumbnail_status")
}

enum ThumbnailSource {
  auto
  upload

  @@map("thumbnail_source")
}

// FEAT-008. 사용자별 카테고리. 링크는 0~1개(ADR-015). 이름은 정규화 값으로 중복 판정(앞뒤 공백·연속 공백·NFC·영문 소문자)
model Category {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  name           String     @db.VarChar(20)
  normalizedName String     @map("normalized_name") @db.VarChar(40)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks      Bookmark[]

  // 같은 이름 금지. 동시 생성의 최종 권위(FEAT-008 AC-02·08)
  @@unique([userId, normalizedName])
  @@map("categories")
}

// FEAT-010·FEAT-008. 사용자별 태그. 이름은 정규화 값으로 중복 판정(앞뒤 공백·연속 공백·NFC·영문 소문자)
model Tag {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  name           String        @db.VarChar(30)
  normalizedName String        @map("normalized_name") @db.VarChar(60)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks      BookmarkTag[]

  @@unique([userId, normalizedName])
  @@map("tags")
}

model BookmarkTag {
  bookmarkId String   @map("bookmark_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, tagId])
  // 태그로 링크 찾기(FEAT-008 필터)
  @@index([tagId])
  @@map("bookmark_tags")
}
