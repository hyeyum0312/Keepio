{
  "name": "@keepio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.mts",
    "test:related": "vitest related --run --reporter=dot --silent=passed-only --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/eslint-plugin": "~1.6.28",
    "eslint": "^9.39.5",
    "eslint-plugin-check-file": "^3.3.2",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "openid-client": "6.8.8",
    "reflect-metadata": "0.2.2",
    "resend": "6.37.0",
    "rxjs": "7.8.2"
  }
}
