{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    "typecheck": {},
    "//#db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["apps/api/src/generated/prisma/**"]
    }
  }
}
