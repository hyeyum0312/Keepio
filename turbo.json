{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "DB_POOL_MAX",
    "PRISMA_TARGET",
    "JWT_SECRET",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "TRUST_PROXY_HOPS",
    "WEB_ORIGIN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "KAKAO_CLIENT_ID",
    "KAKAO_CLIENT_SECRET",
    "API_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    "test:integration": {
      "cache": false
    },
    "typecheck": {},
    "//#db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["apps/api/src/generated/prisma/**"]
    }
  }
}
