{
  "name": "keepio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --output-logs=errors-only",
    "dev:web": "npm run dev --workspace=@keepio/web",
    "dev:api": "turbo run dev --filter=@keepio/api",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:test": "PRISMA_TARGET=test prisma migrate deploy",
    "db:status": "prisma migrate status",
    "verify": "npm run format:check && npm run openapi:check && turbo run lint typecheck test --output-logs=errors-only",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks && git config blame.ignoreRevsFile .git-blame-ignore-revs || true",
    "openapi:generate": "turbo run build --filter=@keepio/api --output-logs=errors-only >/dev/null && node apps/api/dist/openapi-export.js packages/api-client/openapi.json && npm run --silent generate -w @keepio/api-client >/dev/null && prettier --write --log-level warn packages/api-client/openapi.json packages/api-client/src/generated",
    "openapi:check": "bash scripts/check-openapi.sh"
  },
  "overrides": {
    "multer": "2.5.0",
    "@scalar/json-magic@0.15.7": {
      "undici": "7.30.1"
    },
    "jose": "6.2.13"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "turbo": "2.11.10"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "@swc/core@1.16.18": true,
    "argon2@0.45.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  }
}
