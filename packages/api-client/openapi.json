  },
  "info": {
    "title": "keepio API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "error"]
          },
          "db": {
            "type": "string",
            "enum": ["up", "down"]
          }
        },
        "required": ["status", "db"]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "description": "사용자에게 그대로 보여주는 문구. 분기는 code로 한다"
          },
          "requestId": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["code", "message", "requestId"]
      },
      "CredentialsDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": ["email", "password"]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": ["token"]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          }
        },
        "required": ["email"]
      },
      "AccessTokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Access Token 만료까지 초"
          }
        },
        "required": ["accessToken", "expiresIn"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": ["token", "newPassword"]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": ["id", "email", "emailVerified"]
      },
      "OAuthProvidersResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["google", "kakao"]
            }
          }
        },
        "required": ["providers"]
      },
      "SaveBookmarkDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://example.com/article?id=1"
          },
          "title": {
            "type": "string",
            "example": "랜딩 모션 레퍼런스",
            "maxLength": 100
          },
          "tags": {
            "example": ["모션", "랜딩"],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["url"]
      },
      "BookmarkCategoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 20,
            "example": "디자인"
          }
        },
        "required": ["id", "name"]
      },
      "BookmarkTagResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "BookmarkThumbnailResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "ready", "failed"],
            "description": "pending: 가져오는 중, ready: 있음, failed: 없음(직접 올리기 가능)"
          },
          "url": {
            "type": "string",
            "nullable": true,
            "description": "API 기준 경로(서명, 10~20분 유효). API 주소를 앞에 붙여 <img>에 쓴다"
          },
          "sourceUrl": {
            "type": "string",
            "nullable": true,
            "description": "링크 페이지의 og:image 원본 주소(자동 수집, 직접 올렸으면 null). url을 못 쓰면(만료·파일 없음) 이 주소로 바로 불러온다"
          }
        },
        "required": ["status", "url", "sourceUrl"]
      },
      "BookmarkResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "description": "사용자가 저장한 원래 URL"
          },
          "normalizedUrl": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true,
            "description": "저장할 때 넣은 제목"
          },
          "displayTitle": {
            "type": "string",
            "description": "보여 줄 제목: 넣은 제목 → 페이지 제목(og:title) → 도메인"
          },
          "titleSource": {
            "type": "string",
            "enum": ["user", "page", "site"],
            "description": "displayTitle의 출처: user(넣은 제목) · page(페이지 제목) · site(사이트 이름 — 제목을 못 받음)"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "링크의 카테고리 ID(FEAT-008). null이면 미분류"
          },
          "category": {
            "nullable": true,
            "description": "링크의 카테고리(이름까지, AC-16). null이면 미분류. 목록 줄에 이름을 바로 보여 준다",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/BookmarkCategoryResponse"
              }
            ]
          },
          "tags": {
            "description": "이름순",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookmarkTagResponse"
            }
          },
          "thumbnail": {
            "$ref": "#/components/schemas/BookmarkThumbnailResponse"
          },
          "faviconUrl": {
            "type": "string",
            "nullable": true,
            "description": "링크 페이지가 알려 준 사이트 아이콘 주소(apple-touch-icon → icon). 없으면 null이고 화면은 사이트 주소/favicon.ico를 불러 본다. 보여 줄 썸네일이 없을 때 아트워크 위에 올린다"
          }
        },
        "required": [
          "id",
          "url",
          "normalizedUrl",
          "createdAt",
          "deletedAt",
          "title",
          "displayTitle",
          "titleSource",
          "categoryId",
          "category",
          "tags",
          "thumbnail",
          "faviconUrl"
        ]
      },
      "BookmarkConflictErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "description": "사용자에게 그대로 보여주는 문구. 분기는 code로 한다"
          },
          "requestId": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bookmarkId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["code", "message", "requestId", "bookmarkId"]
      },
      "BookmarkListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookmarkResponse"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "다음 페이지 요청에 그대로 넘긴다. 없으면 null"
          }
        },
        "required": ["items", "nextCursor"]
      },
      "UpdateBookmarkDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true,
            "maxLength": 100,
            "example": "다이어리 데이 체크 다이어리",
            "description": "비우거나 null이면 사용자 제목을 지운다. 보내지 않으면 그대로"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "링크의 카테고리(FEAT-008). null이면 미분류. 보내지 않으면 그대로"
          }
        }
      },
      "CategoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 20,
            "example": "여행"
          },
          "bookmarkCount": {
            "type": "number",
            "description": "이 카테고리의 활성 링크 수(휴지통은 세지 않는다)"
          },
          "pinned": {
            "type": "boolean",
            "description": "고정했으면 true. 고정한 것이 목록 맨 위에 온다(AC-15)"
          }
        },
        "required": ["id", "name", "bookmarkCount", "pinned"]
      },
      "CategoryListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "description": "이름순(ko)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryResponse"
            }
          }
        },
        "required": ["items"]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20,
            "example": "여행"
          }
        },
        "required": ["name"]
      },
      "CategoryConflictErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "description": "사용자에게 그대로 보여주는 문구. 분기는 code로 한다"
          },
          "requestId": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["code", "message", "requestId", "categoryId"]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "pinned": {
            "type": "boolean",
            "description": "고정 여부. 고정한 카테고리는 목록 맨 위에 온다(사용자당 8개까지). 같은 값을 다시 보내도 성공한다"
          }
        }
      }
    }
  }
}
